{
  "name": "@hermes/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "build": "tsup",
    "start": "dotenv -e ../../.env -- node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "test": "dotenv -e ../../.env -- vitest run",
    "test:watch": "vitest",
    "test:prepare": "dotenv -e ../../.env -- tsx tests/preparar-banco.ts",
    "typecheck": "tsc --noEmit",
    "senha:redefinir": "dotenv -e ../../.env -- tsx src/cli/redefinir-senha.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@hermes/shared": "*",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "prisma": "^6.19.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.19.0",
    "dotenv-cli": "^11.0.0",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
