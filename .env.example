# ==========================================================
# Hermes — variáveis de ambiente (copie para .env e ajuste)
# ==========================================================

# ---- Banco de dados (PostgreSQL) ----
# Desenvolvimento: o docker-compose.yml sobe o banco nesta porta do PC.
# Se já houver outro Postgres na 5432, troque (ex.: 5434) aqui E na DATABASE_URL.
POSTGRES_PORT=5432
DATABASE_URL="postgresql://hermes:hermes_dev@localhost:5432/hermes?schema=public"

# Banco dos testes automáticos (npm run test:prepare cria as tabelas nele).
# TEST_DATABASE_URL="postgresql://hermes:hermes_dev@localhost:5432/hermes_test?schema=public"

# ---- Servidor ----
API_PORT=3333
API_HOST=0.0.0.0
NODE_ENV=development
# Fuso da oficina: "o caixa de hoje" e "o relatório do mês" são contados nele.
TZ=America/Sao_Paulo
# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info

# Porta da tela no desenvolvimento (Vite). Em produção a própria API serve a tela.
WEB_PORT=5173
# Pasta com a tela compilada. Vazio = procura apps/desktop/dist sozinho.
# WEB_DIR=
# Documentação interativa em /api/docs (padrão: ligada fora de produção).
# API_DOCS=true

# ---- Sessão (login) ----
# Chave secreta das sessões. Em produção é OBRIGATÓRIO trocar: gere com  openssl rand -hex 32
# (Os nomes antigos JWT_SECRET / JWT_EXPIRES_IN ainda são aceitos.)
SESSAO_SEGREDO="troque-por-uma-chave-longa-e-secreta"
# Tempo SEM USO até a sessão cair (30m, 12h, 2d). Um turno de trabalho; usar renova.
SESSAO_DURACAO="12h"
# Cookie só por HTTPS? auto = decide pela conexão (liga atrás de HTTPS, desliga na rede local).
COOKIE_SECURE=auto
# Atrás de proxy reverso (Caddy, Nginx, nuvem)? true para confiar no X-Forwarded-*.
TRUST_PROXY=false
# Origens liberadas no CORS, separadas por vírgula. Vazio = só a mesma origem (o normal).
# CORS_ORIGIN=

# ---- Backup automático do banco ----
# Faz uma cópia quando a mais recente passa de 24h (inclusive ao ligar o servidor).
BACKUP_ENABLED=true
BACKUP_DIR="./backups"
BACKUP_RETENCAO_DIAS=14
# Cifra as cópias (AES-256). Opcional — PERDEU A SENHA, PERDEU AS CÓPIAS. Vazio = SQL puro.
# BACKUP_SENHA=
# Container do banco de desenvolvimento (o pg_dump roda dentro dele, na mesma versão).
BACKUP_CONTAINER="hermes-postgres"
